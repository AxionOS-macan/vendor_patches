From 85e791411c090e07f0aeebc994e0ed88e61be243 Mon Sep 17 00:00:00 2001
From: blazerpaul15 <blazerpaul15@gmail.com>
Date: Sun, 19 Jul 2026 11:23:09 +0900
Subject: [PATCH 9/9] Camera: Increase result FMQ size for Oplus offline
 metadata

Oplus camera offline/APS paths can return large result metadata.
Increase the result FMQ size to avoid metadata delivery failures during
offline reprocess flows.

Change-Id: I3f0f0c6021f0562cdb44d9767c31a56dc8e6e843
---
 services/camera/libcameraservice/api2/CameraDeviceClient.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/services/camera/libcameraservice/api2/CameraDeviceClient.cpp b/services/camera/libcameraservice/api2/CameraDeviceClient.cpp
index 3fd7ef37e8..47125fb469 100644
--- a/services/camera/libcameraservice/api2/CameraDeviceClient.cpp
+++ b/services/camera/libcameraservice/api2/CameraDeviceClient.cpp
@@ -41,6 +41,8 @@
 #include "device3/Camera3OutputStream.h"
 #include "api2/CameraDeviceClient.h"
 
+#include <algorithm>
+
 #include <camera_metadata_hidden.h>
 
 #include "DepthCompositeStream.h"
@@ -66,6 +68,8 @@ using hardware::camera2::ICameraDeviceUser::NO_IN_FLIGHT_REPEATING_FRAMES;
 
 namespace flags = com::android::internal::camera::flags;
 
+static constexpr size_t kMinResultMetadataQueueSize = 2 * 1024 * 1024;
+
 CameraDeviceClientBase::CameraDeviceClientBase(
         const sp<CameraService>& cameraService,
         const sp<hardware::camera2::ICameraDeviceCallbacks>& remoteCallback,
@@ -219,6 +223,7 @@ status_t CameraDeviceClient::initializeImpl(TProviderPtr providerPtr,
     size_t resultMQSize =
             property_get_int32(FMQ_SIZE_PROP.c_str(), /*default*/0);
     resultMQSize = resultMQSize > 0 ? resultMQSize : fmqHalSize;
+    resultMQSize = std::max(resultMQSize, kMinResultMetadataQueueSize);
     res = CreateMetadataQueue(&mResultMetadataQueue, resultMQSize);
     if (res != OK) {
         ALOGE("%s: Creating result metadata queue failed: %s(%d)", __FUNCTION__,
