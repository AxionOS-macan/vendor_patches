 static constexpr const char* gInstanceName = "default";
 static constexpr std::string_view gChargerArg{"--charger"};
+static constexpr const char* kOplusCpaPowerPath = "/sys/class/oplus_chg/common/cpa_power";
+static constexpr const char* kOplusUiPowerPath = "/sys/class/oplus_chg/common/ui_power";
+static constexpr const char* kOplusAdapterPowerPath = "/sys/class/oplus_chg/common/adapter_power";
+static constexpr const char* kUsbVoltageNowPath = "/sys/class/power_supply/usb/voltage_now";
 
 constexpr char *ucsiPSYName[]{
 	(char *const)"ucsi-source-psy-soc:qcom,pmic_glink:qcom,ucsi1",
@@ -37,6 +50,59 @@ constexpr char *ucsiPSYName[]{
 
 #define RETRY_COUNT    100
 
+static bool ReadIntFromFile(const char* path, int* value) {
+    std::string content;
+    if (!android::base::ReadFileToString(path, &content, true)) {
+        return false;
+    }
+
+    errno = 0;
+    char* end = nullptr;
+    long parsed = strtol(content.c_str(), &end, 10);
+    if (end == content.c_str() || errno != 0 || parsed < INT_MIN || parsed > INT_MAX) {
+        return false;
+    }
+
+    *value = static_cast<int>(parsed);
+    return true;
+}
+
+static int ReadFirstPositiveInt(std::initializer_list<const char*> paths) {
+    int value = 0;
+    for (const char* path : paths) {
+        if (ReadIntFromFile(path, &value) && value > 0) {
+            return value;
+        }
+    }
+    return -1;
+}
+
+class QtiHealth : public Health {
+  public:
+    QtiHealth(std::string_view instance_name, std::unique_ptr<healthd_config>&& config)
+        : Health(instance_name, std::move(config)) {}
+
+  protected:
+    void UpdateHealthInfo(HealthInfo* health_info) override {
+        if (health_info == nullptr) {
+            return;
+        }
+
+        const int power_mw = ReadFirstPositiveInt(
+                {kOplusCpaPowerPath, kOplusUiPowerPath, kOplusAdapterPowerPath});
+        int voltage_uv = 0;
+        if (power_mw <= 0 || !ReadIntFromFile(kUsbVoltageNowPath, &voltage_uv)
+                || voltage_uv <= 0) {
+            return;
+        }
+
+        const long current_ua = static_cast<long>(power_mw) * 1'000'000'000L / voltage_uv;
+        health_info->maxChargingVoltageMicrovolts = voltage_uv;
+        health_info->maxChargingCurrentMicroamps = static_cast<int>(
+                std::min(current_ua, static_cast<long>(INT_MAX)));
+    }
+};
+
 void qti_healthd_board_init(struct healthd_config *hc)
 {
     int fd;
@@ -84,7 +150,7 @@ int main(int argc, char** argv) {
