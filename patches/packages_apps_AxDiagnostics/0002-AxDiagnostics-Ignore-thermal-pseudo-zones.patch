From 23f68c80e425b2a1983e5ec5c18a3afe467e7cfc Mon Sep 17 00:00:00 2001
From: blazerpaul15 <blazerpaul15@gmail.com>
Date: Sun, 16 Aug 2026 22:02:26 +0900
Subject: [PATCH] AxDiagnostics: Ignore thermal pseudo-zones

Some devices expose trip, BCL, IBAT and scod limit signals through the
thermal zone interface. These are not live temperature sensors and can
report threshold or sentinel values, causing false thermal emergency
warnings.

Exclude those pseudo-zones from hottest-zone and health calculations.

Change-Id: I38d50c6ba8d7363bb3ee438ebc11180825429428

diff --git a/src/com/axion/diagnostics/data/BatteryInfo.kt b/src/com/axion/diagnostics/data/BatteryInfo.kt
index f8ec637170e1b146e64985455e29a891feaa0635..58e3ac4b2ded4202d5f4e4e069ca3af75946f317 100644
--- a/src/com/axion/diagnostics/data/BatteryInfo.kt
+++ b/src/com/axion/diagnostics/data/BatteryInfo.kt
@@ -150,7 +150,7 @@ object BatteryCollector {
 }
 
 internal fun normalizeBatteryCurrentMa(rawCurrent: Int): Int {
-    if (rawCurrent == 0) return 0
+    if (rawCurrent == 0 || rawCurrent == Int.MIN_VALUE) return 0
     val raw = rawCurrent.toLong()
     val absRaw = abs(raw)
     val currentMa = if (absRaw >= CURRENT_UA_THRESHOLD) {
diff --git a/src/com/axion/diagnostics/data/ThermalInfo.kt b/src/com/axion/diagnostics/data/ThermalInfo.kt
index 4c1e8222f60931ebf8bc9ff021fac9e2d32ec4c5..d59beaf68e9152a4e7583acaaae8facd7700303d 100644
--- a/src/com/axion/diagnostics/data/ThermalInfo.kt
+++ b/src/com/axion/diagnostics/data/ThermalInfo.kt
@@ -76,7 +76,9 @@ object ThermalCollector {
                     if (tripIdx > 20) break
                 }
 
-                zones.add(ThermalZone(zoneDir.name, type, tempC, trips))
+                if (isSensorZone(type, tempC)) {
+                    zones.add(ThermalZone(zoneDir.name, type, tempC, trips))
+                }
             }
         }
 
@@ -99,6 +101,16 @@ object ThermalCollector {
         )
     }
 
+    private fun isSensorZone(type: String, temperatureC: Float): Boolean {
+        val lowerType = type.lowercase()
+        if (lowerType.contains("trip")) return false
+        if (lowerType.contains("bcl")) return false
+        if (lowerType.contains("ibat-lvl")) return false
+        if (lowerType == "socd") return false
+        if (temperatureC <= -100f) return false
+        return true
+    }
+
     private fun readFileText(file: File): String =
         runCatching { file.readText().trim() }.getOrDefault("")
 }
