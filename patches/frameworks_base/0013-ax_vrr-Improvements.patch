+    private static float findDynamicContentMaxRefreshRate(float[] rates, float globalMaxRate) {
+        final int configuredRate = SystemProperties.getInt(
+                "persist.sys.ax.dynamic_content_max_refresh_rate",
+                Math.round(DEFAULT_DYNAMIC_CONTENT_MAX_REFRESH_RATE_HZ));
+        if (configuredRate <= 0) {
+            return globalMaxRate;
+        }
+        final float maxAllowedRate = Math.min(configuredRate, globalMaxRate);
+        float dynamicContentMaxRate = 0f;
+        for (float rate : rates) {
+            if (rate <= maxAllowedRate + RATE_MATCH_TOLERANCE_HZ) {
+                dynamicContentMaxRate = rate;
+            }
+        }
+        return dynamicContentMaxRate > 0f ? dynamicContentMaxRate : rates[0];
+    }
+
     private static float findInteractiveRefreshRate(float[] rates) {
         final float configuredRate = SystemProperties.getInt(
                 "persist.sys.ax.interactive_refresh_rate", 0);
